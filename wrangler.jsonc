{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lernraum",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "lernraum.auer.page", "custom_domain": true }],
  "assets": {
    "directory": "./dist/site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "notizen",
      "database_id": "7f5ba627-dfd3-4ba6-a7cb-e8afcf315eb1",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "snowy-surf-69d3.cloudflareaccess.com",
    "ACCESS_AUD": ""
  },
  "observability": { "enabled": true }
}
